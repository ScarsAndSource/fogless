# --- REQUIRED: login (no defaults any more; without these the login page returns 503)
DEMO_USERNAME=choose-a-username
DEMO_PASSWORD=choose-a-long-random-password
# Signs the login cookie. Generate: python -c "import secrets;print(secrets.token_hex(32))"
SESSION_SECRET=make-up-a-long-random-string-here

# --- Optional
# Groq console (console.groq.com/keys): LLM parsing + voice. Without it the regex fallback is used.
GROQ_API_KEY=your_groq_api_key
# Supabase dashboard -> Project Settings -> API. Without these, data lives in memory only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# Set to 1 only for the minute you need /reset confirm on the live database
ALLOW_RESET=
