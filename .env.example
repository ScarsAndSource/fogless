# ---------------------------------------------------------------- REQUIRED (Supabase: Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
# "anon" / publishable key. Used only for sign-up / sign-in / refresh. Safe to expose in principle, but this
# app keeps it server-side too.
SUPABASE_ANON_KEY=your-anon-key
# "service_role" / secret key. Server-only. Bypasses Row Level Security, so NEVER put it in frontend code.
SUPABASE_SERVICE_KEY=your-service-role-key

# ---------------------------------------------------------------- RECOMMENDED
# The public URL of your deployment. Password-reset emails link back to SITE_URL/reset.html, and that exact URL
# must be allow-listed in Supabase -> Authentication -> URL Configuration -> Redirect URLs.
SITE_URL=https://your-app.vercel.app
# Groq console (console.groq.com/keys): LLM parsing + voice. Without it the regex fallback parser is used.
GROQ_API_KEY=your_groq_api_key

# ---------------------------------------------------------------- OPTIONAL
# Registration controls. SIGNUPS_OPEN=0 closes sign-up entirely. SIGNUP_CODE (if set) is an invite code that
# new users must enter -- a cheap way to keep strangers from burning your Groq quota.
SIGNUPS_OPEN=1
SIGNUP_CODE=
# Per-user message caps (each message can cost a Groq call on YOUR key). 0 disables a cap.
RATE_LIMIT_PER_MIN=20
RATE_LIMIT_PER_DAY=300

# ---------------------------------------------------------------- LOCAL ONLY
# 1 = in-memory accounts and data, no Supabase needed (ignored if Supabase is configured or on Vercel).
FOGLESS_DEV_MODE=
