# Get from @BotFather on Telegram
BOT_TOKEN=your_bot_token

# Get from @userinfobot on Telegram (your numeric user ID — locks the bot to only you)
OWNER_ID=your_telegram_numeric_id

# Any random string you make up yourself — used to verify incoming webhooks are really from Telegram
TELEGRAM_SECRET_TOKEN=make-up-a-long-random-string-here

# Another random string you make up — protects the daily cron/backup endpoint
CRON_SECRET=make-up-a-different-random-string-here

# Groq console (console.groq.com/keys) — free tier, used to parse freeform messages
GROQ_API_KEY=your_groq_api_key

# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
