<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/info_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/info_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:textColor="#716450"
            android:text="@string/widget_info_title_default" />

        <TextView
            android:id="@+id/info_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:textSize="10sp"
            android:textColor="#716450" />

        <TextView
            android:id="@+id/info_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="&#x21BB;"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#2A4533"
            android:contentDescription="@string/widget_refresh_cd" />
    </LinearLayout>

    <TextView
        android:id="@+id/info_big"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
        android:textSize="28sp"
        android:textColor="#243528" />

    <TextView
        android:id="@+id/info_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:textColor="#716450" />

    <LinearLayout
        android:id="@+id/row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/row1_l"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:textSize="12sp"
            android:textColor="#243528" />

        <TextView
            android:id="@+id/row1_r"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="#243528" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/row2_l"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:textSize="12sp"
            android:textColor="#243528" />

        <TextView
            android:id="@+id/row2_r"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="#243528" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/row3_l"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:textSize="12sp"
            android:textColor="#243528" />

        <TextView
            android:id="@+id/row3_r"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="#243528" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/row4_l"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:textSize="12sp"
            android:textColor="#243528" />

        <TextView
            android:id="@+id/row4_r"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="#243528" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/row5_l"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:textSize="12sp"
            android:textColor="#243528" />

        <TextView
            android:id="@+id/row5_r"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="#243528" />
    </LinearLayout>

</LinearLayout>
